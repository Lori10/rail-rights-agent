# Rail Rights Agent configuration. Copy to .env (gitignored) and uncomment what you change.
# Every value below is the default; see src/rail_rights_agent/settings.py.

# Models (Bedrock EU cross-region inference profiles / model ids)
# RAILAGENT_PRIMARY_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# RAILAGENT_COMPARISON_MODEL_ID=eu.amazon.nova-2-lite-v1:0
# RAILAGENT_EMBEDDING_MODEL_ID=cohere.embed-v4:0

# AWS environment (the region is locked: any value other than eu-north-1 is rejected)
# RAILAGENT_AWS_REGION=eu-north-1
# RAILAGENT_AWS_PROFILE=railagent

# Cost alerts: a monthly AWS Budget is deployed only when an email is set. Never commit it.
# RAILAGENT_BUDGET_EMAIL=
# RAILAGENT_BUDGET_LIMIT_USD=20
