# devflow plugin configuration (read by the hooks and scripts/check.sh; parsed, never executed).
# Editing this file asks for confirmation inside Claude Code: it controls the guardrails.
DEVFLOW_PROTECTED_BRANCH=main
DEVFLOW_OPENSPEC_VERSION=1.15.0
DEVFLOW_CHECK_CMD=scripts/check.sh
DEVFLOW_FAST_TEST_CMD=uv run --quiet pytest -q -x --ff
DEVFLOW_CODE_PATHS=src tests infra pyproject.toml
DEVFLOW_TEST_PATHS=tests
DEVFLOW_LINT_CMD=uv run --quiet ruff check --force-exclude
DEVFLOW_LINT_GLOBS=*.py
DEVFLOW_SERVICES=
DEVFLOW_PUBLIC_REPO=true
DEVFLOW_CLOUD=aws
DEVFLOW_AWS_REGION=eu-north-1
DEVFLOW_STOP_TIMEOUT=300
